# =================================================================
# FS-7 AI Image Generation Platform - Environment Configuration
# =================================================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here

# MySQL Database Configuration
DB_NAME=zap_imagegen
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Image Generation Provider
# Options: auto | gemini | openai | stability | pollinations
# - gemini: Requires GEMINI_API_KEY (Google Imagen 3 via AI Studio)
# - openai: Requires OPENAI_API_KEY (DALL-E 3)
# - stability: Requires STABILITY_API_KEY (SDXL)
# - pollinations: High-quality Diffusion AI, zero setup required, free
AI_PROVIDER=auto

# Provider API Credentials (Optional if using pollinations)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=your_stability_api_key_here
